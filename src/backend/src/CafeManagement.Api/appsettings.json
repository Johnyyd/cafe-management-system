{
  "ConnectionStrings": {
    "MongoDB": "mongodb://mongodb:27017",
    "DatabaseName": "cafe_management"
  },
  "Seq": {
    "ServerUrl": "http://seq:80"
  },
  "Jwt": {
    "Key": "",
    "Issuer": "cafe-management",
    "Audience": "cafe-management-client",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173",
      "https://cafe-management.example.com"
    ]
  },
  "RateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "HttpStatusCode": 429,
    "QuotaExceededResponse": {
      "Content": "{\"title\":\"Too many requests\",\"status\":429,\"detail\":\"Rate limit exceeded. Please try again later.\"}",
      "ContentType": "application/problem+json",
      "StatusCode": 429
    },
    "GeneralRules": [
      {
        "Endpoint": "*",
        "Period": "1m",
        "Limit": 100
      },
      {
        "Endpoint": "*",
        "Period": "1h",
        "Limit": 2000
      }
    ]
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "Seq", "Args": { "serverUrl": "http://seq:80" } }
    ]
  }
}