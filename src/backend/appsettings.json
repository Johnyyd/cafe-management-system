{
  "ConnectionStrings": {
    "MongoDB": "mongodb://localhost:7891",
    "DatabaseName": "cafe_management"
  },
  "Seq": {
    "ServerUrl": "http://localhost:7892"
  },
  "Jwt": {
    "Key": "",
    "Issuer": "cafe-management",
    "Audience": "cafe-management-client",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173",
      "https://cafe-management.example.com"
    ]
  },
  "RateLimiting": {
    "DefaultPermitLimit": 100,
    "DefaultWindowSeconds": 60
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "Seq", "Args": { "serverUrl": "http://localhost:7892" } }
    ]
  }
}